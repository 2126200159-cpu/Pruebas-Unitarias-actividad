<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="900.0" prefWidth="1280.0" styleClass="area-trabajo" stylesheets="@../css/vetplus.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <fx:define>
      <ToggleGroup fx:id="grupoMenu" />
   </fx:define>
   <left>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxWidth="224.0" minWidth="224.0" prefWidth="224.0" styleClass="scroll-lateral" vbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="30.0" styleClass="shell-lateral">
               <padding>
                  <Insets bottom="30.0" left="18.0" right="18.0" top="30.0" />
               </padding>
               <children>
                  <StackPane maxHeight="76.0" minHeight="76.0" prefHeight="76.0" styleClass="marca-caja">
                     <children>
                        <ImageView fx:id="imgLogoLateral" fitHeight="72.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/vetplus-logo.png" />
                           </image>
                        </ImageView>
                     </children>
                  </StackPane>
                  <VBox spacing="6.0">
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                     <children>
                        <Label fx:id="lblClinica" styleClass="lateral-titulo" text="Clínica VETPLUS" />
                        <Label fx:id="lblRol" styleClass="lateral-sub-10" text="MÉDICO VETERINARIO" />
                     </children>
                  </VBox>
                  <VBox spacing="7.0">
                     <children>
                        <ToggleButton fx:id="btnMenuAgenda" maxWidth="1.7976931348623157E308" mnemonicParsing="false" selected="true" styleClass="menu-item" text="Mi agenda" toggleGroup="$grupoMenu">
                           <graphic>
                              <StackPane maxHeight="18.0" maxWidth="18.0" minHeight="18.0" minWidth="18.0" prefHeight="18.0" prefWidth="18.0">
                                 <children>
                                    <SVGPath content="M8 2v4 M16 2v4 M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M3 10h18 M8 14h.01 M12 14h.01 M16 14h.01 M8 18h.01 M12 18h.01 M16 18h.01" scaleX="0.75" scaleY="0.75" styleClass="icon-menu" />
                                 </children>
                              </StackPane>
                           </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="btnMenuConsulta" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="menu-item" text="Consulta médica" toggleGroup="$grupoMenu">
                           <graphic>
                              <StackPane maxHeight="18.0" maxWidth="18.0" minHeight="18.0" minWidth="18.0" prefHeight="18.0" prefWidth="18.0">
                                 <children>
                                    <SVGPath content="M11 2v2 M5 2v2 M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1 M8 15a6 6 0 0 0 12 0v-3 M18 10a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" scaleX="0.75" scaleY="0.75" styleClass="icon-menu" />
                                 </children>
                              </StackPane>
                           </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="btnMenuExpedientes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="menu-item" text="Expedientes" toggleGroup="$grupoMenu">
                           <graphic>
                              <StackPane maxHeight="18.0" maxWidth="18.0" minHeight="18.0" minWidth="18.0" prefHeight="18.0" prefWidth="18.0">
                                 <children>
                                    <SVGPath content="M9 2h6a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M12 11h4 M12 16h4 M8 11h.01 M8 16h.01" scaleX="0.75" scaleY="0.75" styleClass="icon-menu" />
                                 </children>
                              </StackPane>
                           </graphic>
                        </ToggleButton>
                     </children>
                  </VBox>
                  <Region maxHeight="1.7976931348623157E308" minHeight="0.0" prefHeight="0.0" VBox.vgrow="ALWAYS" />
                  <VBox spacing="8.0" styleClass="lateral-linea">
                     <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                     </padding>
                     <children>
                        <Label fx:id="lblNombreUsuario" styleClass="lateral-titulo" />
                        <HBox alignment="CENTER_LEFT" spacing="4.0">
                           <children>
                              <Label fx:id="lblRolUsuario" styleClass="lateral-sub-11" text="Médico veterinario ·" />
                              <Hyperlink fx:id="lnkCerrarSesion" styleClass="lateral-enlace" text="Cerrar sesión" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </left>
   <center>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" maxHeight="76.0" minHeight="76.0" prefHeight="76.0" spacing="20.0" styleClass="barra-superior">
               <padding>
                  <Insets left="32.0" right="32.0" />
               </padding>
               <children>
                  <Label fx:id="lblMigaPan" styleClass="texto-12" text="Clínica VETPLUS / Mi agenda" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblFecha" styleClass="texto-12" />
                  <Button fx:id="btnNotificaciones" focusTraversable="false" mnemonicParsing="false" styleClass="boton-icono-simple">
                     <graphic>
                        <StackPane maxHeight="18.0" maxWidth="18.0" minHeight="18.0" minWidth="18.0" prefHeight="18.0" prefWidth="18.0">
                           <children>
                              <SVGPath content="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9 M10.3 21a1.94 1.94 0 0 0 3.4 0" scaleX="0.75" scaleY="0.75" styleClass="icon-stroke" />
                           </children>
                        </StackPane>
                     </graphic>
                  </Button>
                  <StackPane maxHeight="32.0" maxWidth="32.0" minHeight="32.0" minWidth="32.0" prefHeight="32.0" prefWidth="32.0" styleClass="perfil-circulo">
                     <children>
                        <Label fx:id="lblIniciales" styleClass="perfil-iniciales" />
                     </children>
                  </StackPane>
               </children>
            </HBox>
            <ScrollPane fx:id="scrollVistas" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-vistas" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
               <content>
                  <StackPane fx:id="contenedorVistas" alignment="TOP_LEFT">
                     <children>
                        <fx:include fx:id="vistaAgenda" source="agenda-medico.fxml" />
                     </children>
                  </StackPane>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
</BorderPane>