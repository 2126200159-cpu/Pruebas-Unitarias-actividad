                        <SVGPath content="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3" scaleX="0.6667" scaleY="0.6667" styleClass="icon-stroke, icon-oscuro" />
                     </children>
                  </StackPane>
               </graphic>
            </Button>
         </children>
      </HBox>
      <HBox spacing="10.0">
         <children>
            <ToggleButton fx:id="tglPacientesDia" maxWidth="1.7976931348623157E308" minHeight="54.0" mnemonicParsing="false" prefWidth="100.0" selected="true" styleClass="reporte-opcion" text="Pacientes del día" toggleGroup="$grupoReportes" HBox.hgrow="ALWAYS" />
            <ToggleButton fx:id="tglPacientesServicio" maxWidth="1.7976931348623157E308" minHeight="54.0" mnemonicParsing="false" prefWidth="100.0" styleClass="reporte-opcion" text="Pacientes por servicio" toggleGroup="$grupoReportes" HBox.hgrow="ALWAYS" />
            <ToggleButton fx:id="tglContactoCliente" maxWidth="1.7976931348623157E308" minHeight="54.0" mnemonicParsing="false" prefWidth="100.0" styleClass="reporte-opcion" text="Contacto del cliente" toggleGroup="$grupoReportes" HBox.hgrow="ALWAYS" />
