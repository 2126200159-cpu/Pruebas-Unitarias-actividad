                  <Label fx:id="lblPorcentajesEspecie" styleClass="texto-12" text="—" />
                  <Label maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-12-oscuro" text="Consulta el catálogo completo para agrupar todas las mascotas registradas." wrapText="true" />
               </children>
            </VBox>
            <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="16.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="titulo-17" text="Familias y contactos" />
                  <Hyperlink fx:id="lnkClientesDescuento" styleClass="enlace-negro" text="Clientes con descuento →" />
                  <VBox>
                     <children>
                        <Label fx:id="lblClienteDescuento" styleClass="texto-11" text="Sin clientes con descuento" />
