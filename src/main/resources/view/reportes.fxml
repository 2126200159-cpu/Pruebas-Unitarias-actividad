            <ToggleButton fx:id="tglClientesDescuento" maxWidth="1.7976931348623157E308" minHeight="54.0" mnemonicParsing="false" prefWidth="100.0" styleClass="reporte-opcion" text="Clientes con descuento" toggleGroup="$grupoReportes" HBox.hgrow="ALWAYS" />
