                        <StackPane maxHeight="20.0" maxWidth="20.0" minHeight="20.0" minWidth="20.0" prefHeight="20.0" prefWidth="20.0">
                           <children>
                              <SVGPath content="M12 16v5 M16 14v7 M20 10v11 M22 3L13.354 11.646a0.5 0.5 0 0 1-0.708 0L9.354 8.354a0.5 0.5 0 0 0-0.707 0L2 15 M4 18v3 M8 14v7" scaleX="0.8333" scaleY="0.8333" styleClass="icon-stroke" />
