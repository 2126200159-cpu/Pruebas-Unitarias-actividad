                  <TableColumn fx:id="colRepPaciente" prefWidth="170.0" text="Paciente" />
                  <TableColumn fx:id="colRepPropietario" prefWidth="190.0" text="Propietario" />
                  <TableColumn fx:id="colRepServicio" prefWidth="180.0" text="Servicio" />
