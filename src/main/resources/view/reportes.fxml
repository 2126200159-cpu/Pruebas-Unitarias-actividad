                     </children>
                  </HBox>
                  <VBox fx:id="contenedorServicios" spacing="16.0">
                     <children>
                        <Label fx:id="lblSinServicios" styleClass="texto-12" text="Sin cobros en este periodo." />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="16.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
