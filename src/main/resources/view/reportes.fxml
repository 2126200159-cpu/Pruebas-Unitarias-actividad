                        <Label styleClass="texto-12" text="Pacientes cobrados hoy ·" />
                        <Hyperlink fx:id="lnkVerReporteEspecies" styleClass="enlace" text="Ver reporte →" />
                     </children>
                  </HBox>
                  <Label fx:id="lblEspecies" styleClass="metrica-verde" text="Sin datos" />
