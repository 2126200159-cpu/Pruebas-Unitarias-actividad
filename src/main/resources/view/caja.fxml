<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox prefWidth="1056.0" spacing="24.0" styleClass="area-trabajo" stylesheets="@../css/vetplus.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="algo.vetplusapp.ctrl.CajaController">
   <padding>
      <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="titulo-28" text="Caja y pagos" />
                  <Label styleClass="texto-13" text="Una cuenta clara para cada familia" />
               </children>
            </VBox>
            <Button fx:id="btnNuevaCuenta" graphicTextGap="8.0" mnemonicParsing="false" styleClass="boton-secundario" text="Nueva cuenta">
               <graphic>
                  <StackPane maxHeight="16.0" maxWidth="16.0" minHeight="16.0" minWidth="16.0" prefHeight="16.0" prefWidth="16.0">
                     <children>
                        <SVGPath content="M5 12h14 M12 5v14" scaleX="0.6667" scaleY="0.6667" styleClass="icon-stroke, icon-oscuro" />
                     </children>
                  </StackPane>
               </graphic>
            </Button>
         </children>
      </HBox>
      <HBox alignment="TOP_LEFT" spacing="24.0">
         <children>
            <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="20.0" HBox.hgrow="ALWAYS">
               <children>
                  <VBox spacing="16.0" styleClass="tarjeta">
                     <children>
                        <HBox alignment="TOP_LEFT">
                           <children>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="lblClienteCuenta" styleClass="titulo-20" text="Selecciona una cuenta" />
                                    <Label fx:id="lblDetalleCuenta" styleClass="texto-12" />
                                 </children>
                              </VBox>
                              <Label fx:id="lblEstadoCuenta" managed="false" styleClass="chip" visible="false" />
                           </children>
                        </HBox>
                        <TableView fx:id="tblCuenta" fixedCellSize="58.0" minHeight="211.0" prefHeight="211.0" styleClass="tabla-vet">
                           <columns>
                              <TableColumn fx:id="colCuentaPaciente" prefWidth="130.0" text="Paciente" />
                              <TableColumn fx:id="colCuentaServicio" prefWidth="140.0" text="Servicio" />
                              <TableColumn fx:id="colCuentaCantidad" prefWidth="70.0" text="Cant." />
                              <TableColumn fx:id="colCuentaPrecio" prefWidth="120.0" text="Precio" />
                              <TableColumn fx:id="colCuentaImporte" prefWidth="138.0" text="Importe" />
                           </columns>
                           <placeholder>
                              <Label styleClass="texto-12" text="La cuenta aún no tiene servicios." />
                           </placeholder>
                        </TableView>
                        <HBox fx:id="cajaAvisoDescuento" alignment="TOP_LEFT" managed="false" spacing="10.0" styleClass="caja-aviso" visible="false">
                           <children>
                              <StackPane maxHeight="18.0" maxWidth="18.0" minHeight="18.0" minWidth="18.0" prefHeight="18.0" prefWidth="18.0">
                                 <children>
                                    <SVGPath content="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0 M12 16v-4 M12 8h.01" scaleX="0.75" scaleY="0.75" styleClass="icon-stroke" />
                                 </children>
                              </StackPane>
                              <Label fx:id="lblAvisoDescuento" maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-12" wrapText="true" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <HBox alignment="TOP_LEFT" spacing="24.0">
                           <children>
                              <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="10.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="texto-12-negrita" text="Así se calcula el descuento" />
                                    <VBox>
                                       <children>
                                          <Label styleClass="texto-12" text="1 mascota: 0%" />
                                          <Label styleClass="texto-12" text="2 mascotas: 15%" />
                                          <Label styleClass="texto-12" text="3 o más mascotas: 25%" />
                                       </children>
                                    </VBox>
                                    <Label maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-11" text="Se aplica una sola tasa al subtotal. No se suman porcentajes ni se cuentan servicios como mascotas." wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox maxWidth="236.0" minWidth="236.0" prefWidth="236.0" spacing="14.0" styleClass="caja-totales">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label styleClass="texto-12-oscuro" text="Subtotal" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblSubtotal" styleClass="texto-12-oscuro" text="\$0.00" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label fx:id="lblDescuentoEtiqueta" styleClass="texto-12" text="Descuento 0%" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblDescuentoMonto" styleClass="texto-12" text="−$0.00" />
                                       </children>
                                    </HBox>
                                    <Label styleClass="texto-12" text="Total a pagar · MXN" />
                                    <Label fx:id="lblTotalPagar" styleClass="total-32" text="\$0.00" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox spacing="16.0" styleClass="tarjeta">
                     <children>
                        <Label styleClass="titulo-17" text="Otras cuentas pendientes" />
                        <TableView fx:id="tblPendientes" fixedCellSize="58.0" minHeight="153.0" prefHeight="153.0" styleClass="tabla-vet">
                           <columns>
                              <TableColumn fx:id="colPendCliente" prefWidth="190.0" text="Cliente / paciente" />
                              <TableColumn fx:id="colPendConcepto" prefWidth="170.0" text="Concepto" />
                              <TableColumn fx:id="colPendFecha" prefWidth="100.0" text="Fecha" />
                              <TableColumn fx:id="colPendSaldo" prefWidth="138.0" text="Saldo" />
                           </columns>
                           <placeholder>
                              <Label styleClass="texto-12" text="No hay cuentas pendientes." />
                           </placeholder>
                        </TableView>
                     </children>
                  </VBox>
                  <VBox spacing="16.0" styleClass="tarjeta">
                     <children>
                        <Label styleClass="titulo-17" text="Últimos pagos recibidos" />
                        <TableView fx:id="tblPagos" fixedCellSize="58.0" minHeight="153.0" prefHeight="153.0" styleClass="tabla-vet">
                           <columns>
                              <TableColumn fx:id="colPagoHora" prefWidth="90.0" text="Hora" />
                              <TableColumn fx:id="colPagoCliente" prefWidth="200.0" text="Cliente / paciente" />
                              <TableColumn fx:id="colPagoMetodo" prefWidth="150.0" text="Método" />
                              <TableColumn fx:id="colPagoCobrado" prefWidth="158.0" text="Cobrado" />
                           </columns>
                           <placeholder>
                              <Label styleClass="texto-12" text="Aún no se han recibido pagos hoy." />
                           </placeholder>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox maxWidth="326.0" minWidth="326.0" prefWidth="326.0" spacing="20.0">
               <children>
                  <VBox spacing="16.0" styleClass="tarjeta">
                     <children>
                        <Label styleClass="titulo-17" text="Confirmar cobro" />
                        <Label fx:id="lblClienteCobro" styleClass="texto-12" text="Selecciona una cuenta para cobrar." />
                        <VBox spacing="7.0">
                           <children>
                              <Label styleClass="campo-etiqueta" text="Método de pago" />
                              <ComboBox fx:id="cmbMetodoPago" maxWidth="1.7976931348623157E308" promptText="Selecciona un método" styleClass="campo-combo" />
                           </children>
                        </VBox>
                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="btnMetodoTarjeta" mnemonicParsing="false" styleClass="chip-boton" text="Tarjeta" />
                              <Button fx:id="btnMetodoEfectivo" mnemonicParsing="false" styleClass="chip-boton" text="Efectivo" />
                              <Button fx:id="btnMetodoTransferencia" mnemonicParsing="false" styleClass="chip-boton" text="Transferencia" />
                           </children>
                        </HBox>
                        <VBox spacing="7.0">
                           <children>
                              <Label styleClass="campo-etiqueta" text="Importe a cobrar (MXN)" />
                              <TextField fx:id="txtImporteCobrar" minHeight="44.0" prefHeight="44.0" promptText="0.00" styleClass="campo-texto" />
                           </children>
                        </VBox>
                        <VBox spacing="7.0">
                           <children>
                              <Label styleClass="campo-etiqueta" text="Referencia de pago" />
                              <TextField fx:id="txtReferenciaPago" minHeight="44.0" prefHeight="44.0" promptText="Autorización de terminal" styleClass="campo-texto" />
                           </children>
                        </VBox>
                        <VBox spacing="7.0">
                           <children>
                              <Label styleClass="campo-etiqueta" text="Enviar comprobante a" />
                              <TextField fx:id="txtCorreoComprobante" minHeight="44.0" prefHeight="44.0" promptText="correo@ejemplo.com" styleClass="campo-texto" />
                           </children>
                        </VBox>
                        <HBox fx:id="cajaAvisoCobro" alignment="TOP_LEFT" managed="false" spacing="10.0" styleClass="caja-aviso" visible="false">
                           <children>
                              <StackPane maxHeight="18.0" maxWidth="18.0" minHeight="18.0" minWidth="18.0" prefHeight="18.0" prefWidth="18.0">
                                 <children>
                                    <SVGPath content="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0 M12 16v-4 M12 8h.01" scaleX="0.75" scaleY="0.75" styleClass="icon-stroke" />
                                 </children>
                              </StackPane>
                              <Label fx:id="lblAvisoCobro" maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-12" wrapText="true" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Button fx:id="btnConfirmarCobro" graphicTextGap="8.0" maxWidth="-Infinity" mnemonicParsing="false" styleClass="boton-naranja" text="Confirmar cobro · $0.00">
                           <graphic>
                              <StackPane maxHeight="16.0" maxWidth="16.0" minHeight="16.0" minWidth="16.0" prefHeight="16.0" prefWidth="16.0">
                                 <children>
                                    <SVGPath content="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M2 10h20" scaleX="0.6667" scaleY="0.6667" styleClass="icon-stroke, icon-oscuro" />
                                 </children>
                              </StackPane>
                           </graphic>
                        </Button>
                        <Button fx:id="btnGuardarPendiente" maxWidth="-Infinity" mnemonicParsing="false" styleClass="boton-secundario" text="Guardar cuenta pendiente" />
                     </children>
                  </VBox>
                  <VBox spacing="16.0" styleClass="caja-crema">
                     <children>
                        <Label styleClass="titulo-17" text="Cierre de caja" />
                        <VBox>
                           <children>
                              <Label fx:id="lblCobradoHoy" styleClass="texto-12-oscuro" text="Cobrado hoy: $0.00" />
                              <Label fx:id="lblResumenCierre" styleClass="texto-12-oscuro" text="0 pacientes · 0 cuentas pagadas" />
                           </children>
                        </VBox>
                        <Hyperlink fx:id="lnkVerReporteDia" styleClass="enlace" text="Ver reporte del día →" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT">
         <padding>
            <Insets top="8.0" />
         </padding>
         <children>
            <Label styleClass="texto-10" text="VETPLUS · Clínica veterinaria." />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="texto-10" text="© 2026 VETPLUS. Todos los derechos reservados." />
         </children>
      </HBox>
   </children>
</VBox>