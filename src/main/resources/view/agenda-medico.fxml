<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox prefWidth="1056.0" spacing="24.0" styleClass="area-trabajo" stylesheets="@../css/vetplus.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="algo.vetplusapp.ctrl.AgendaMedicoController">
   <padding>
      <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
   </padding>
   <fx:define>
      <ToggleGroup fx:id="grupoEstadoCitas" />
   </fx:define>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="titulo-28" text="Mi agenda" />
                  <Label fx:id="lblSubtituloAgenda" styleClass="texto-13" text="Tus pacientes, a su tiempo" />
               </children>
            </VBox>
            <Label fx:id="lblTurno" managed="false" styleClass="chip" visible="false" />
         </children>
      </HBox>
      <HBox spacing="16.0">
         <children>
            <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="16.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="texto-12" text="Citas asignadas" />
                  <Label fx:id="lblCitasAsignadas" styleClass="metrica-valor" text="0" />
                  <Label fx:id="lblDetalleAsignadas" styleClass="texto-11" text="Sin citas asignadas" />
               </children>
            </VBox>
            <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="16.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="texto-12" text="En atención" />
                  <Label fx:id="lblEnAtencion" styleClass="metrica-valor" text="0" />
                  <Label fx:id="lblDetalleEnAtencion" styleClass="texto-11" text="Sin paciente en atención" />
               </children>
            </VBox>
            <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="16.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="texto-12" text="Por atender" />
                  <Label fx:id="lblPorAtender" styleClass="metrica-valor" text="0" />
                  <Label fx:id="lblDetallePorAtender" styleClass="texto-11" text="Sin siguiente cita" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="TOP_LEFT" spacing="24.0">
         <children>
            <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="20.0" HBox.hgrow="ALWAYS">
               <children>
                  <VBox spacing="16.0" styleClass="tarjeta">
                     <children>
                        <Label fx:id="lblFechaAgenda" styleClass="titulo-17" text="Agenda del día" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Button fx:id="btnDiaAnterior" mnemonicParsing="false" styleClass="boton-secundario" text="‹" />
                              <Button fx:id="btnHoy" mnemonicParsing="false" styleClass="boton-secundario" text="Hoy" />
                              <DatePicker fx:id="dtpFechaAgenda" maxWidth="-Infinity" minWidth="170.0" prefWidth="170.0" promptText="Fecha" styleClass="campo-combo" />
                              <Button fx:id="btnDiaSiguiente" mnemonicParsing="false" styleClass="boton-secundario" text="›" />
                           </children>
                        </HBox>
                        <HBox spacing="8.0">
                           <children>
                              <ToggleButton fx:id="tglTodas" mnemonicParsing="false" selected="true" styleClass="filtro-estado" text="Todos · 0" toggleGroup="$grupoEstadoCitas" />
                              <ToggleButton fx:id="tglEnAtencion" mnemonicParsing="false" styleClass="filtro-estado" text="En atención" toggleGroup="$grupoEstadoCitas" />
                              <ToggleButton fx:id="tglConfirmadas" mnemonicParsing="false" styleClass="filtro-estado" text="Confirmadas" toggleGroup="$grupoEstadoCitas" />
                              <ToggleButton fx:id="tglFinalizadas" mnemonicParsing="false" styleClass="filtro-estado" text="Finalizadas" toggleGroup="$grupoEstadoCitas" />
                           </children>
                        </HBox>
                        <TableView fx:id="tblAgendaMedico" fixedCellSize="58.0" minHeight="211.0" prefHeight="211.0" styleClass="tabla-vet">
                           <columns>
                              <TableColumn fx:id="colHorario" prefWidth="110.0" text="Horario" />
                              <TableColumn fx:id="colPacientePropietario" prefWidth="170.0" text="Paciente / propietario" />
                              <TableColumn fx:id="colServicio" prefWidth="130.0" text="Servicio" />
                              <TableColumn fx:id="colConsultorio" prefWidth="100.0" text="Consultorio" />
                              <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
                           </columns>
                           <placeholder>
                              <Label styleClass="texto-12" text="No hay citas asignadas para este día." />
                           </placeholder>
                        </TableView>
                        <Label styleClass="texto-11" text="Solo se muestran las citas asignadas a tu sesión. Duración de consulta: 30 minutos." />
                     </children>
                  </VBox>
                  <VBox spacing="16.0" styleClass="tarjeta">
                     <children>
                        <Label styleClass="titulo-17" text="Atención actual" />
                        <Label fx:id="lblSinAtencion" styleClass="texto-12" text="No hay una atención en curso." />
                        <VBox fx:id="contenedorAtencionActual" managed="false" spacing="16.0" visible="false">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="fila-mascota">
                                 <children>
                                    <StackPane maxHeight="42.0" maxWidth="42.0" minHeight="42.0" minWidth="42.0" prefHeight="42.0" prefWidth="42.0" styleClass="avatar-mascota">
                                       <children>
                                          <StackPane maxHeight="20.0" maxWidth="20.0" minHeight="20.0" minWidth="20.0" prefHeight="20.0" prefWidth="20.0">
                                             <children>
                                                <SVGPath content="M9 4a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M16 8a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M18 16a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z" scaleX="0.8333" scaleY="0.8333" styleClass="icon-stroke" />
                                             </children>
                                          </StackPane>
                                       </children>
                                    </StackPane>
                                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label fx:id="lblAtencionMascota" styleClass="titulo-14" />
                                          <Label fx:id="lblAtencionDetalle" styleClass="texto-11" />
                                       </children>
                                    </VBox>
                                    <StackPane maxHeight="16.0" maxWidth="16.0" minHeight="16.0" minWidth="16.0" prefHeight="16.0" prefWidth="16.0">
                                       <children>
                                          <SVGPath content="M9 18l6-6-6-6" scaleX="0.6667" scaleY="0.6667" styleClass="icon-stroke" />
                                       </children>
                                    </StackPane>
                                 </children>
                              </HBox>
                              <Label fx:id="lblAtencionHorario" maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-12-oscuro" wrapText="true" />
                              <HBox fx:id="cajaAvisoNota" alignment="TOP_LEFT" managed="false" spacing="10.0" styleClass="caja-aviso" visible="false">
                                 <children>
                                    <StackPane maxHeight="18.0" maxWidth="18.0" minHeight="18.0" minWidth="18.0" prefHeight="18.0" prefWidth="18.0">
                                       <children>
                                          <SVGPath content="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0 M12 16v-4 M12 8h.01" scaleX="0.75" scaleY="0.75" styleClass="icon-stroke" />
                                       </children>
                                    </StackPane>
                                    <Label maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-12" text="La nota médica sigue en curso. Continúa la atención para completar el registro clínico." wrapText="true" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <HBox spacing="12.0">
                                 <children>
                                    <Button fx:id="btnVerExpedienteActual" mnemonicParsing="false" styleClass="boton-secundario" text="Ver expediente" />
                                    <Button fx:id="btnContinuarAtencion" mnemonicParsing="false" styleClass="boton-naranja" text="Continuar atención" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox spacing="16.0" styleClass="tarjeta">
                     <children>
                        <Label styleClass="titulo-17" text="Organiza tu turno" />
                        <Label fx:id="lblSinTurno" styleClass="texto-12" text="Aún no hay citas para organizar." />
                        <HBox fx:id="contenedorTurno" managed="false" spacing="24.0" visible="false">
                           <children>
                              <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="lblIntervaloLibre" styleClass="texto-12-negrita" />
                                    <Label fx:id="lblIntervaloLibreTexto" maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-12" text="Sin citas asignadas. Tiempo disponible entre atenciones." wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="lblPreparacionTitulo" styleClass="texto-12-negrita" />
                                    <Label fx:id="lblPreparacionTexto" maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-12" text="Revisa sus antecedentes antes de iniciar la siguiente consulta." wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox maxWidth="304.0" minWidth="304.0" prefWidth="304.0" spacing="20.0">
               <children>
                  <VBox spacing="16.0" styleClass="caja-crema">
                     <children>
                        <Label styleClass="titulo-17" text="Próxima atención" />
                        <Label fx:id="lblSinProxima" styleClass="texto-12" text="No hay próximas atenciones." />
                        <VBox fx:id="contenedorProxima" managed="false" spacing="16.0" visible="false">
                           <children>
                              <Label fx:id="lblSiguienteHora" styleClass="chip" />
                              <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="fila-mascota">
                                 <children>
                                    <StackPane maxHeight="42.0" maxWidth="42.0" minHeight="42.0" minWidth="42.0" prefHeight="42.0" prefWidth="42.0" styleClass="avatar-mascota">
                                       <children>
                                          <StackPane maxHeight="20.0" maxWidth="20.0" minHeight="20.0" minWidth="20.0" prefHeight="20.0" prefWidth="20.0">
                                             <children>
                                                <SVGPath content="M9 4a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M16 8a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M18 16a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z" scaleX="0.8333" scaleY="0.8333" styleClass="icon-stroke" />
                                             </children>
                                          </StackPane>
                                       </children>
                                    </StackPane>
                                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label fx:id="lblProximaMascota" styleClass="titulo-14" />
                                          <Label fx:id="lblProximaPropietaria" styleClass="texto-11" />
                                       </children>
                                    </VBox>
                                    <StackPane maxHeight="16.0" maxWidth="16.0" minHeight="16.0" minWidth="16.0" prefHeight="16.0" prefWidth="16.0">
                                       <children>
                                          <SVGPath content="M9 18l6-6-6-6" scaleX="0.6667" scaleY="0.6667" styleClass="icon-stroke" />
                                       </children>
                                    </StackPane>
                                 </children>
                              </HBox>
                              <Label fx:id="lblProximaServicio" styleClass="titulo-14" />
                              <VBox>
                                 <children>
                                    <Label fx:id="lblProximaHorario" styleClass="texto-12-oscuro" />
                                    <Label fx:id="lblProximaConsultorio" styleClass="texto-12-oscuro" />
                                 </children>
                              </VBox>
                              <Label fx:id="lblProximaMedico" styleClass="texto-12" />
                              <Button fx:id="btnVerExpedienteProxima" maxWidth="-Infinity" mnemonicParsing="false" styleClass="boton-secundario" text="Ver expediente" />
                              <Button fx:id="btnIniciarAtencion" maxWidth="-Infinity" mnemonicParsing="false" styleClass="boton-naranja" text="Iniciar atención" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox spacing="16.0" styleClass="tarjeta">
                     <children>
                        <Label styleClass="titulo-17" text="Antes de atender" />
                        <Label maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-12-oscuro" text="Comprueba la identidad del paciente y confirma el motivo de consulta con su propietario." wrapText="true" />
                        <Label maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-12" text="Las notas clínicas se registran desde Consulta médica y quedan en el expediente del paciente." wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT">
         <padding>
            <Insets top="8.0" />
         </padding>
         <children>
            <Label styleClass="texto-10" text="VETPLUS · Clínica veterinaria." />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="texto-10" text="© 2026 VETPLUS. Todos los derechos reservados." />
         </children>
      </HBox>
   </children>
</VBox>