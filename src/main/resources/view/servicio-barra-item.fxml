<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="260.0" spacing="6.0" styleClass="plantilla" stylesheets="@../css/vetplus.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label fx:id="lblServicioNombre" styleClass="texto-11-oscuro" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblServicioImporte" styleClass="texto-11-negrita" />
         </children>
      </HBox>
      <ProgressBar fx:id="pbServicio" maxWidth="1.7976931348623157E308" progress="0.0" styleClass="barra-reporte" />
   </children>
</VBox>