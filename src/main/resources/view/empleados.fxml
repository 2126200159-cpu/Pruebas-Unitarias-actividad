<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox prefWidth="1056.0" spacing="24.0" styleClass="area-trabajo" stylesheets="@../css/vetplus.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="algo.vetplusapp.ctrl.EmpleadosController">
   <padding>
      <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
   </padding>
   <fx:define>
      <ToggleGroup fx:id="grupoFiltroEmpleados" />
   </fx:define>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="titulo-28" text="Un equipo que cuida" />
                  <Label styleClass="texto-13" text="Administra los perfiles, turnos y accesos de la clínica." />
               </children>
            </VBox>
            <Button fx:id="btnAltaEmpleado" graphicTextGap="8.0" mnemonicParsing="false" styleClass="boton-naranja" text="Alta de empleado">
               <graphic>
                  <StackPane maxHeight="16.0" maxWidth="16.0" minHeight="16.0" minWidth="16.0" prefHeight="16.0" prefWidth="16.0">
                     <children>
                        <SVGPath content="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0 M19 8v6 M22 11h-6" scaleX="0.6667" scaleY="0.6667" styleClass="icon-stroke, icon-oscuro" />
                     </children>
                  </StackPane>
               </graphic>
            </Button>
         </children>
      </HBox>
      <HBox alignment="TOP_LEFT" spacing="24.0">
         <children>
            <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="20.0" HBox.hgrow="ALWAYS">
               <children>
                  <VBox spacing="16.0" styleClass="tarjeta">
                     <children>
                        <VBox spacing="7.0">
                           <children>
                              <Label styleClass="campo-etiqueta" text="Buscar en el equipo" />
                              <TextField fx:id="txtBuscarEmpleado" minHeight="44.0" prefHeight="44.0" promptText="⌕  Nombre, especialidad o rol" styleClass="campo-texto" />
                           </children>
                        </VBox>
                        <HBox spacing="10.0">
                           <children>
                              <ToggleButton fx:id="tglTodos" mnemonicParsing="false" selected="true" styleClass="chip-filtro" text="Todos · 0">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="grupoFiltroEmpleados" />
                                 </toggleGroup></ToggleButton>
                              <ToggleButton fx:id="tglMedicos" mnemonicParsing="false" styleClass="chip-filtro" text="Médicos · 0" toggleGroup="$grupoFiltroEmpleados" />
                              <ToggleButton fx:id="tglEstilistas" mnemonicParsing="false" styleClass="chip-filtro" text="Estilistas · 0" toggleGroup="$grupoFiltroEmpleados" />
                              <ToggleButton fx:id="tglAdministracion" mnemonicParsing="false" styleClass="chip-filtro" text="Administración · 0" toggleGroup="$grupoFiltroEmpleados" />
                           </children>
                        </HBox>
                        <TableView fx:id="tblEmpleados" fixedCellSize="58.0" minHeight="385.0" prefHeight="385.0" styleClass="tabla-vet">
                           <columns>
                              <TableColumn fx:id="colEmpleado" prefWidth="150.0" text="Empleado" />
                              <TableColumn fx:id="colRolEspecialidad" prefWidth="170.0" text="Rol / especialidad" />
                              <TableColumn fx:id="colTurno" prefWidth="110.0" text="Turno" />
                              <TableColumn fx:id="colEstadoEmpleado" prefWidth="144.0" text="Estado" />
                           </columns>
                           <placeholder>
                              <Label styleClass="texto-12" text="Aún no hay empleados registrados." />
                           </placeholder>
                        </TableView>
                        <Label fx:id="lblResumenEmpleados" styleClass="texto-11" text="0 empleados registrados · 0 activos" />
                     </children>
                  </VBox>
                  <VBox spacing="16.0" styleClass="tarjeta">
                     <children>
                        <Label styleClass="titulo-17" text="Permisos por perfil" />
                        <HBox alignment="TOP_LEFT" spacing="24.0">
                           <children>
                              <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="texto-13-verde-negrita" text="Médico" />
                                    <Label maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-12-oscuro" text="Consulta su agenda, accede a datos e historial del paciente y registra la atención médica." wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="texto-13-verde-negrita" text="Estilista canino" />
                                    <Label maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-12-oscuro" text="Consulta baños y cortes asignados, datos del paciente y finaliza los servicios de estética." wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox alignment="TOP_LEFT" spacing="10.0" styleClass="caja-aviso">
                           <children>
                              <StackPane maxHeight="18.0" maxWidth="18.0" minHeight="18.0" minWidth="18.0" prefHeight="18.0" prefWidth="18.0">
                                 <children>
                                    <SVGPath content="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0 M12 16v-4 M12 8h.01" scaleX="0.75" scaleY="0.75" styleClass="icon-stroke" />
                                 </children>
                              </StackPane>
                              <Label maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-12" text="Solo administración gestiona empleados, tarifas, proveedores, insumos y órdenes de compra." wrapText="true" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox maxWidth="350.0" minWidth="350.0" prefWidth="350.0">
               <children>
                  <VBox spacing="16.0" styleClass="tarjeta">
                     <children>
                        <Label styleClass="titulo-17" text="Editar perfil" />
                        <Label fx:id="lblEmpleadoEditando" styleClass="texto-12" text="Selecciona un empleado o da de alta uno nuevo." />
                        <HBox alignment="CENTER_LEFT" spacing="14.0">
                           <children>
                              <StackPane maxHeight="72.0" maxWidth="72.0" minHeight="72.0" minWidth="72.0" prefHeight="72.0" prefWidth="72.0" styleClass="perfil-circulo">
                                 <children>
                                    <Label fx:id="lblInicialesFoto" style="-fx-font-size: 20px;" styleClass="perfil-iniciales" />
                                    <ImageView fx:id="imgFotoEmpleado" fitHeight="72.0" fitWidth="72.0" pickOnBounds="true" preserveRatio="false" />
                                 </children>
                              </StackPane>
                              <VBox alignment="CENTER_LEFT" spacing="4.0">
                                 <children>
                                    <Button fx:id="btnElegirFoto" mnemonicParsing="false" styleClass="boton-secundario" text="Elegir imagen" />
                                    <Hyperlink fx:id="lnkQuitarFoto" styleClass="enlace-11" text="Quitar foto" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox spacing="12.0">
                           <children>
                              <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="7.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="campo-etiqueta" text="Nombre" />
                                    <TextField fx:id="txtNombreEmpleado" minHeight="44.0" prefHeight="44.0" promptText="Nombre" styleClass="campo-texto" />
                                 </children>
                              </VBox>
                              <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="7.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="campo-etiqueta" text="Apellidos" />
                                    <TextField fx:id="txtApellidosEmpleado" minHeight="44.0" prefHeight="44.0" promptText="Apellidos" styleClass="campo-texto" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox spacing="7.0">
                           <children>
                              <Label styleClass="campo-etiqueta" text="Rol" />
                              <ComboBox fx:id="cmbRolEmpleado" maxWidth="1.7976931348623157E308" promptText="Selecciona un rol" styleClass="campo-combo" />
                           </children>
                        </VBox>
                        <VBox spacing="7.0">
                           <children>
                              <Label styleClass="campo-etiqueta" text="Especialidad" />
                              <TextField fx:id="txtEspecialidad" minHeight="44.0" prefHeight="44.0" promptText="Especialidad" styleClass="campo-texto" />
                           </children>
                        </VBox>
                        <HBox spacing="12.0">
                           <children>
                              <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="7.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="campo-etiqueta" text="Turno" />
                                    <ComboBox fx:id="cmbTurno" maxWidth="1.7976931348623157E308" promptText="Turno" styleClass="campo-combo" />
                                 </children>
                              </VBox>
                              <VBox maxWidth="1.7976931348623157E308" prefWidth="100.0" spacing="7.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="campo-etiqueta" text="Estado" />
                                    <ComboBox fx:id="cmbEstadoEmpleado" maxWidth="1.7976931348623157E308" promptText="Estado" styleClass="campo-combo" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox spacing="7.0">
                           <children>
                              <Label styleClass="campo-etiqueta" text="Correo electrónico" />
                              <TextField fx:id="txtCorreoEmpleado" minHeight="44.0" prefHeight="44.0" promptText="correo@ejemplo.com" styleClass="campo-texto" />
                           </children>
                        </VBox>
                        <VBox spacing="7.0">
                           <children>
                              <Label styleClass="campo-etiqueta" text="Teléfono" />
                              <TextField fx:id="txtTelefonoEmpleado" minHeight="44.0" prefHeight="44.0" promptText="55 0000 0000" styleClass="campo-texto" />
                           </children>
                        </VBox>
                        <VBox spacing="7.0">
                           <children>
                              <Label styleClass="campo-etiqueta" text="CURP" />
                              <TextField fx:id="txtCurpEmpleado" minHeight="44.0" prefHeight="44.0" promptText="18 caracteres" styleClass="campo-texto" />
                           </children>
                        </VBox>
                        <VBox spacing="7.0">
                           <children>
                              <Label styleClass="campo-etiqueta" text="Dirección" />
                              <TextField fx:id="txtDireccionEmpleado" minHeight="44.0" prefHeight="44.0" promptText="Calle, número, colonia, ciudad y código postal" styleClass="campo-texto" />
                           </children>
                        </VBox>
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnGuardarEmpleado" mnemonicParsing="false" styleClass="boton-naranja" text="Guardar cambios" />
                              <Button fx:id="btnCancelarEmpleado" mnemonicParsing="false" styleClass="boton-secundario" text="Cancelar" />
                           </children>
                        </HBox>
                        <HBox prefHeight="35.0" prefWidth="304.0">
                           <children>
                              <Button fx:id="btnEliminarEmpleado" mnemonicParsing="false" style="-fx-text-fill: #B3261E;" styleClass="boton-secundario" text="Eliminar empleado" />
                           </children>
                        </HBox>
                        <VBox spacing="2.0">
                           <children>
                              <Hyperlink fx:id="lnkVerContrasenaTemporal" styleClass="enlace-11" text="Ver contraseña temporal →" />
                              <Hyperlink fx:id="lnkRestablecerContrasena" styleClass="enlace-11" text="Restablecer contraseña →" />
                              <Label maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="texto-10" text="La contraseña temporal se puede ver hasta que el empleado la cambie; después solo se puede restablecer." wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT">
         <padding>
            <Insets top="8.0" />
         </padding>
         <children>
            <Label styleClass="texto-10" text="VETPLUS · Clínica veterinaria." />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="texto-10" text="© 2026 VETPLUS. Todos los derechos reservados." />
         </children>
      </HBox>
   </children>
</VBox>
