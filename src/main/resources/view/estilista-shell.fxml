<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="900.0" prefWidth="1280.0" styleClass="area-trabajo" stylesheets="@../css/vetplus.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <fx:define>
      <ToggleGroup fx:id="grupoMenu" />
   </fx:define>
   <left>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxWidth="224.0" minWidth="224.0" prefWidth="224.0" styleClass="scroll-lateral" vbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="30.0" styleClass="shell-lateral">
               <padding>
                  <Insets bottom="30.0" left="18.0" right="18.0" top="30.0" />
               </padding>
               <children>
                  <StackPane maxHeight="76.0" minHeight="76.0" prefHeight="76.0" styleClass="marca-caja">
                     <children>
                        <ImageView fx:id="imgLogoLateral" fitHeight="72.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/vetplus-logo.png" />
                           </image>
                        </ImageView>
                     </children>
                  </StackPane>
                  <VBox spacing="6.0">
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                     <children>
                        <Label fx:id="lblClinica" styleClass="lateral-titulo" text="Clínica VETPLUS" />
                        <Label fx:id="lblRol" styleClass="lateral-sub-10" text="ESTILISTA CANINO" />
                     </children>
                  </VBox>
                  <VBox spacing="7.0">
                     <children>
                        <ToggleButton fx:id="btnMenuEstetica" maxWidth="1.7976931348623157E308" mnemonicParsing="false" selected="true" styleClass="menu-item" text="Estética canina" toggleGroup="$grupoMenu">
                           <graphic>
                              <StackPane maxHeight="18.0" maxWidth="18.0" minHeight="18.0" minWidth="18.0" prefHeight="18.0" prefWidth="18.0">
                                 <children>
                                    <SVGPath content="M3 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0 M3 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0 M20 4L8.12 15.88 M14.47 14.48L20 20 M8.12 8.12L12 12" scaleX="0.75" scaleY="0.75" styleClass="icon-menu" />
                                 </children>
                              </StackPane>
                           </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="btnMenuPacientes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="menu-item" text="Mis pacientes" toggleGroup="$grupoMenu">
                           <graphic>
                              <StackPane maxHeight="18.0" maxWidth="18.0" minHeight="18.0" minWidth="18.0" prefHeight="18.0" prefWidth="18.0">
                                 <children>
                                    <SVGPath content="M9 4a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M16 8a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M18 16a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z" scaleX="0.75" scaleY="0.75" styleClass="icon-menu" />
                                 </children>
                              </StackPane>
                           </graphic>
                        </ToggleButton>
                     </children>
                  </VBox>
                  <Region maxHeight="1.7976931348623157E308" minHeight="0.0" prefHeight="0.0" VBox.vgrow="ALWAYS" />
                  <VBox spacing="8.0" styleClass="lateral-linea">
                     <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                     </padding>
                     <children>
                        <Label fx:id="lblNombreUsuario" styleClass="lateral-titulo" />
                        <HBox alignment="CENTER_LEFT" spacing="4.0">
                           <children>
                              <Label fx:id="lblRolUsuario" styleClass="lateral-sub-11" text="Estilista canino ·" />
                              <Hyperlink fx:id="lnkCerrarSesion" styleClass="lateral-enlace" text="Cerrar sesión" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </left>
   <center>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" maxHeight="76.0" minHeight="76.0" prefHeight="76.0" spacing="20.0" styleClass="barra-superior">
               <padding>
                  <Insets left="32.0" right="32.0" />
               </padding>
               <children>
                  <Label fx:id="lblMigaPan" styleClass="texto-12" text="Clínica VETPLUS / Estética canina" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblFecha" styleClass="texto-12" />
                  <Button fx:id="btnNotificaciones" focusTraversable="false" mnemonicParsing="false" styleClass="boton-icono-simple">
                     <graphic>
                        <StackPane maxHeight="18.0" maxWidth="18.0" minHeight="18.0" minWidth="18.0" prefHeight="18.0" prefWidth="18.0">
                           <children>
                              <SVGPath content="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9 M10.3 21a1.94 1.94 0 0 0 3.4 0" scaleX="0.75" scaleY="0.75" styleClass="icon-stroke" />
                           </children>
                        </StackPane>
                     </graphic>
                  </Button>
                  <StackPane maxHeight="32.0" maxWidth="32.0" minHeight="32.0" minWidth="32.0" prefHeight="32.0" prefWidth="32.0" styleClass="perfil-circulo">
                     <children>
                        <Label fx:id="lblIniciales" styleClass="perfil-iniciales" />
                     </children>
                  </StackPane>
               </children>
            </HBox>
            <ScrollPane fx:id="scrollVistas" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-vistas" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
               <content>
                  <StackPane fx:id="contenedorVistas" alignment="TOP_LEFT">
                     <children>
                        <fx:include fx:id="vistaEstetica" source="estetica-canina.fxml" />
                     </children>
                  </StackPane>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
</BorderPane>